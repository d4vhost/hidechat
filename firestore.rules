rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts']))
      );
    }

    match /friend_requests/{requestId} {
      // allow read if user is sender or receiver
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromId || 
        request.auth.uid == resource.data.toId
      );
      
      // allow create if user is the sender
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromId;
      
      // allow update (accept/reject) if user is the receiver
      allow update: if isAuthenticated() && request.auth.uid == resource.data.toId;
      
      // allow delete if user is sender or receiver
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromId || 
        request.auth.uid == resource.data.toId
      );
    }

    match /messages/{messageId} {
      // allow read if user is part of the conversation
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['conversationId', 'senderId', 'receiverId', 'text', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'sent';
        
      allow update: if isAuthenticated()
        && request.resource.data.text == resource.data.text
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
        
      // allow delete if user is part of conversation
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
    }
    
    // Reglas para presencia
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Reglas para indicador "Escribiendo"
    match /typing/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}

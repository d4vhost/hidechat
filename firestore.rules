rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Owner can write anything to their own document
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Others can only update the contacts array
      allow update: if request.auth != null && request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts']);
    }

    // Private subcollection for sensitive data (passwordHash, recoveryKeyHash)
    match /users/{userId}/private/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /friend_requests/{requestId} {
      // allow read if user is sender or receiver
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromId || 
        request.auth.uid == resource.data.toId
      );
      
      // allow create if user is the sender
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromId;
      
      // allow update (accept/reject) if user is the receiver
      allow update: if isAuthenticated() && request.auth.uid == resource.data.toId;
      
      // allow delete if user is sender or receiver
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromId || 
        request.auth.uid == resource.data.toId
      );
    }

    match /messages/{messageId} {
      // allow read if user is part of the conversation
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['conversationId', 'senderId', 'receiverId', 'text', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'sent';
        
      // Only conversation participants can update, and cannot change text/senderId/timestamps
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId)
        && request.resource.data.text == resource.data.text
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
        
      // allow delete if user is part of conversation
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
    }
    
    // Presence rules
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Typing indicator rules
    match /typing/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // QR Sync rules - read is public because the secondary device listens BEFORE authenticating.
    // Session IDs are cryptographically random UUIDs, making brute-force infeasible.
    // Documents are deleted after use and should have a short TTL.
    match /qr_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
